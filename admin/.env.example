# --- Обязательно сменить перед продакшеном ---
# В режиме NODE_ENV=production сервер НЕ запустится с дефолтными/слабыми значениями.
# Пароль: минимум 8 символов. Секрет: минимум 24 случайных символа.
# Сгенерировать секрет: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=change-me-please
ADMIN_JWT_SECRET=please-change-this-secret-to-a-random-long-string

ADMIN_PORT=4322
SITE_PATH=../trust-site

# production включает строгую проверку секретов и режим прода
NODE_ENV=development

# Origin сайта для приёма заявок (CORS на /api/lead). Пример: https://trust-inc-trade.by
SITE_ORIGIN=

# Опционально: уведомление о новой заявке в Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
