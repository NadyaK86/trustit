# Публичные переменные (префикс PUBLIC_ попадает в клиентский бандл)

# Канонический URL сайта (sitemap, OG). На Cloudflare Pages: https://<имя-проекта>.pages.dev или свой домен
PUBLIC_SITE_URL=

# Приоритетный приём заявок: собственный бэкенд админки (данные остаются в РБ — 99-З о ПДн).
# Пример: https://trust-inc-trade.by/api/lead  (проксируется nginx на админку)
PUBLIC_LEAD_ENDPOINT=

# Fallback: URL формы Formspree (используется, только если PUBLIC_LEAD_ENDPOINT пуст).
# Внимание: Formspree — зарубежный сервис, трансграничная передача ПДн.
PUBLIC_FORMSPREE_URL=

# Опционально: reCAPTCHA v3 (ключ сайта)
PUBLIC_RECAPTCHA_SITE_KEY=

# Опционально: номер счётчика Яндекс.Метрики для reachGoal form_<тип>
PUBLIC_YANDEX_METRIKA_ID=
