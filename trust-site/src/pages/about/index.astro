---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
import ParallaxSection from '../../components/ParallaxSection.astro';
import { siteImg } from '../../lib/site-images';
import { getEntry } from 'astro:content';

const entry = await getEntry('site', 'about');
if (!entry) throw new Error('Добавьте src/content/site/about.md');

const d = entry.data as Record<string, unknown>;
const stats = d.stats as Array<{ value: string; label: string }>;
const values = d.values as Array<{ num: string; title: string; desc: string }>;
const competencies = d.competencies as string[];
const partnerBullets = d.partnerBullets as string[];
const parallaxBg = siteImg(String(d.parallaxImageKey ?? 'parallaxAbout'));
---

<Layout title={String(d.title)} description={d.description ? String(d.description) : undefined}>

  <!-- Hero -->
  <section class="border-b border-slate-100 py-20 md:py-28 bg-white">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-[11px] font-semibold text-blue-700 uppercase tracking-[0.2em] mb-4">{d.heroEyebrow}</p>
          <h1 class="font-display text-4xl md:text-5xl font-semibold text-slate-900 leading-tight mb-6 tracking-tight" set:html={String(d.heroTitle).trim().replace(/\n/g, '<br/>')} />
          <p class="text-lg text-slate-500 leading-relaxed mb-6" set:html={String(d.heroLead).trim().replace(/\n/g, ' ')} />
          <p class="text-base text-slate-500 leading-relaxed">
            {d.heroSecondaryBefore}{' '}
            <span class="text-slate-900 font-medium">{d.heroSecondaryHighlight}</span>{' '}
            {d.heroSecondaryAfter}
          </p>
        </div>
        <!-- Stats -->
        <div class="grid grid-cols-2 gap-4">
          {stats.map(s => (
            <div class="bg-slate-50 border border-slate-100 rounded-2xl p-6">
              <span class="text-4xl font-semibold text-slate-900 block mb-1">{s.value}</span>
              <span class="text-sm text-slate-500">{s.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-24">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="mb-12">
        <p class="text-xs font-semibold text-blue-600 uppercase tracking-widest mb-2">{d.valuesEyebrow}</p>
        <h2 class="text-3xl md:text-4xl font-semibold text-slate-900">{d.valuesTitle}</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {values.map(v => (
          <div class="fade-in border border-slate-200 rounded-xl p-6 hover:border-blue-200 transition-colors">
            <span class="text-3xl font-light text-slate-100 font-mono block mb-4">{v.num}</span>
            <h3 class="font-semibold text-slate-900 mb-2">{v.title}</h3>
            <p class="text-sm text-slate-500 leading-relaxed">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Competencies + SmartPlayer -->
  <section class="py-24 bg-slate-50 border-y border-slate-100">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <!-- Компетенции -->
        <div>
          <p class="text-xs font-semibold text-blue-600 uppercase tracking-widest mb-2">{d.competenciesEyebrow}</p>
          <h2 class="text-3xl font-semibold text-slate-900 mb-8">{d.competenciesTitle}</h2>
          <ul class="space-y-3">
            {competencies.map(c => (
              <li class="flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-500 shrink-0"></span>
                <span class="text-slate-700 text-sm">{c}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- SmartPlayer partner block -->
        <div class="bg-white border border-slate-200 rounded-2xl p-8">
          <span class="inline-block text-xs font-semibold text-blue-600 uppercase tracking-widest mb-4 px-3 py-1 bg-blue-50 rounded-full">
            {d.partnerBadge}
          </span>
          <h3 class="text-2xl font-semibold text-slate-900 mb-3">{d.partnerTitle}</h3>
          <p class="text-slate-500 text-sm leading-relaxed mb-6" set:html={String(d.partnerLead).trim().replace(/\n/g, ' ')} />
          <ul class="space-y-2 mb-8">
            {partnerBullets.map(item => (
              <li class="flex items-center gap-2 text-sm text-slate-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>
          <a
            href={String(d.partnerCtaHref)}
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors"
          >
            {d.partnerCtaLabel}
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Parallax CTA -->
  <ParallaxSection
    bgImage={parallaxBg}
    height="340px"
  >
    <div class="max-w-6xl mx-auto px-6 lg:px-8 py-16 text-center w-full">
      <h2 class="text-3xl md:text-4xl font-semibold text-white mb-4">{d.parallaxTitle}</h2>
      <p class="text-white/50 mb-8 max-w-md mx-auto text-base">
        {d.parallaxLead}
      </p>
      <a
        href={String(d.parallaxCtaHref)}
        class="inline-flex items-center gap-2 px-8 py-4 bg-white text-blue-700 font-semibold rounded-lg hover:bg-blue-50 transition-colors text-sm"
      >
        {d.parallaxCtaLabel}
      </a>
    </div>
  </ParallaxSection>

  <!-- Contact form -->
  <div class="max-w-6xl mx-auto px-6 lg:px-8 py-24">
    <ContactForm variant="full" title={String(d.formTitle)} subtitle={String(d.formSubtitle)} />
  </div>

</Layout>
