---
import Layout from '../../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('site', 'catalog');
if (!entry) throw new Error('Добавьте src/content/site/catalog.md');

const d = entry.data as Record<string, unknown>;
const categories = d.categories as Array<{ title: string; desc: string; hint: string }>;
---

<Layout title={String(d.title)} description={d.description ? String(d.description) : undefined}>
  <div class="max-w-6xl mx-auto px-6 lg:px-8 py-16">
    <div class="mb-14">
      <p class="text-xs font-semibold text-blue-600 uppercase tracking-widest mb-3">{d.eyebrow}</p>
      <h1 class="text-4xl md:text-5xl font-semibold text-slate-900">{d.pageTitle}</h1>
      <p class="mt-4 text-lg text-slate-500 max-w-2xl" set:html={String(d.lead).trim().replace(/\n/g, ' ')} />
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {categories.map((c, i) => (
        <article class="fade-in flex flex-col border border-slate-200 rounded-2xl p-6 bg-white hover:border-blue-200 hover:shadow-sm transition-all">
          <span class="text-[10px] font-mono text-slate-300 mb-2">{(i + 1).toString().padStart(2, '0')}</span>
          <span class="text-[11px] text-blue-600 font-medium uppercase tracking-wider mb-2">{c.hint}</span>
          <h2 class="text-lg font-semibold text-slate-900 mb-2 leading-snug">{c.title}</h2>
          <p class="text-sm text-slate-500 leading-relaxed flex-1">{c.desc}</p>
          <a
            href={String(d.ctaHref)}
            class="mt-5 inline-flex items-center justify-center text-sm font-semibold text-blue-700 border border-blue-200 rounded-xl py-2.5 hover:bg-blue-50 transition-colors"
          >
            {d.ctaLabel}
          </a>
        </article>
      ))}
    </div>

    <p class="mt-12 text-sm text-slate-400 max-w-2xl">
      {d.footerNote}{' '}
      <a href={String(d.footerContactsHref)} class="text-blue-600 hover:underline">{d.footerContactsLabel}</a>.
    </p>
  </div>
</Layout>
