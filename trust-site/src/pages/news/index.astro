---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('news').catch(() => []);
const sorted = posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// Новости из админки (коллекция news). Источник истины — админка.
const items = sorted.map((p) => ({
  slug: `/news/${p.id}`,
  title: p.data.title,
  date: p.data.date,
  tag: p.data.tag,
  excerpt: p.data.excerpt,
  image: (p.data as { image?: string }).image,
}));
---

<Layout title="Новости" description="Новости ТрастИнкомТрэйд: обновления SmartPlayer, новинки оборудования, мероприятия и аналитика рынка.">
  <section class="border-b border-slate-100 py-20">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <p class="text-xs font-semibold text-blue-600 uppercase tracking-widest mb-3">Новости</p>
      <h1 class="text-4xl md:text-5xl font-semibold text-slate-900">Актуальное</h1>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      {items.length === 0 && (
        <div class="text-center py-16 border border-dashed border-slate-200 rounded-2xl">
          <p class="text-slate-500">Новостей пока нет.</p>
        </div>
      )}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {items.map(item => (
          <a href={item.slug} class="fade-in group border border-slate-200 rounded-xl overflow-hidden hover:shadow-sm transition-shadow">
            <div class="aspect-video bg-slate-100 flex items-center justify-center overflow-hidden">
              {item.image
                ? <img src={item.image} alt={item.title} class="w-full h-full object-cover" loading="lazy" />
                : <p class="text-sm text-slate-400">Изображение</p>}
            </div>
            <div class="p-5">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs text-blue-600 font-medium bg-blue-50 px-2 py-0.5 rounded-full">{item.tag}</span>
                <span class="text-xs text-slate-400">{new Date(item.date).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
              </div>
              <h2 class="font-semibold text-slate-900 group-hover:text-blue-600 transition-colors leading-snug">{item.title}</h2>
              <p class="mt-2 text-sm text-slate-500 leading-relaxed line-clamp-3">{item.excerpt}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
