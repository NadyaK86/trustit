---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('portfolio').catch(() => []);

// Проекты из админки (коллекция portfolio). Источник истины — админка.
const items = projects.map((p) => {
  const data = p.data as { title: string; sector: string; desc: string; tags?: string[]; image?: string };
  return {
    slug: `#${p.id}`,
    title: data.title,
    sector: data.sector,
    desc: data.desc,
    tags: data.tags ?? [],
    image: data.image,
  };
});

// Фильтр секторов строим из реальных данных
const dynamicSectors = Array.from(new Set(items.map((p) => p.sector).filter(Boolean)));
const sectors = ['Все', ...dynamicSectors];
---

<Layout title="Портфолио" description="Выполненные проекты ТрастИнкомТрэйд: видеостены, AV-системы, SmartPlayer, IT-инфраструктура.">
  <section class="border-b border-slate-100 py-20">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <p class="text-xs font-semibold text-blue-600 uppercase tracking-widest mb-3">Кейсы</p>
      <h1 class="text-4xl md:text-5xl font-semibold text-slate-900 mb-4">Выполненные проекты</h1>
      <p class="text-lg text-slate-500 max-w-xl">Реализованные объекты в Беларуси и за её пределами.</p>
    </div>
  </section>

  <!-- Sector filter -->
  {items.length > 0 && dynamicSectors.length > 1 && (
    <section class="py-8 border-b border-slate-100" data-portfolio-filter>
      <div class="max-w-6xl mx-auto px-6 lg:px-8">
        <div class="flex flex-wrap gap-2">
          {sectors.map((s, i) => (
            <button
              type="button"
              data-sector={i === 0 ? '' : s}
              class:list={[
                'px-4 py-1.5 rounded-full text-sm font-medium transition-colors portfolio-sector-btn',
                i === 0
                  ? 'bg-blue-600 text-white is-active'
                  : 'bg-white border border-slate-200 text-slate-600 hover:border-slate-400',
              ]}
            >
              {s}
            </button>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="py-16">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      {items.length === 0 && (
        <div class="text-center py-16 border border-dashed border-slate-200 rounded-2xl">
          <p class="text-slate-500">Проекты скоро появятся.</p>
          <a href="/contacts" class="inline-block mt-4 text-blue-600 font-medium hover:underline">Обсудить ваш проект →</a>
        </div>
      )}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {items.map(p => (
          <a href={p.slug} data-card-sector={p.sector} class="portfolio-card fade-in group border border-slate-200 rounded-xl overflow-hidden hover:shadow-md transition-shadow">
            <div class="aspect-video bg-slate-100 flex items-center justify-center overflow-hidden">
              {p.image
                ? <img src={p.image} alt={p.title} class="w-full h-full object-cover" loading="lazy" />
                : <p class="text-sm text-slate-400">Фото проекта</p>}
            </div>
            <div class="p-5">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs text-blue-600 font-medium">{p.sector}</span>
              </div>
              <h2 class="font-semibold text-slate-900 group-hover:text-blue-600 transition-colors">{p.title}</h2>
              <p class="mt-1 text-sm text-slate-500 leading-relaxed">{p.desc}</p>
              <div class="mt-3 flex flex-wrap gap-1">
                {p.tags.map(t => (
                  <span class="px-2 py-0.5 bg-slate-100 text-slate-600 text-xs rounded">{t}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-6 lg:px-8 pb-24">
    <ContactForm variant="estimate" title="Обсудить ваш проект" subtitle="Расскажите о задаче — подготовим концепцию и расчёт." />
  </div>
</Layout>

<script>
  // Фильтрация портфолио по сектору
  function setupPortfolioFilter() {
    const filter = document.querySelector('[data-portfolio-filter]');
    if (!filter) return;
    const buttons = Array.from(filter.querySelectorAll<HTMLButtonElement>('.portfolio-sector-btn'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.portfolio-card'));

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const sector = btn.dataset.sector || '';
        buttons.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('is-active', active);
          b.classList.toggle('bg-blue-600', active);
          b.classList.toggle('text-white', active);
          b.classList.toggle('bg-white', !active);
          b.classList.toggle('border', !active);
          b.classList.toggle('border-slate-200', !active);
          b.classList.toggle('text-slate-600', !active);
        });
        cards.forEach((c) => {
          c.style.display = !sector || c.dataset.cardSector === sector ? '' : 'none';
        });
      });
    });
  }

  document.addEventListener('astro:page-load', setupPortfolioFilter);
  if (document.readyState !== 'loading') setupPortfolioFilter();
  else document.addEventListener('DOMContentLoaded', setupPortfolioFilter, { once: true });
</script>
