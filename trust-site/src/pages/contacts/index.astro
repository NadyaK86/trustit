---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { getEntry } from 'astro:content';
import { getSiteSettings } from '../../lib/site-settings';

const entry = await getEntry('site', 'contacts');
if (!entry) throw new Error('Добавьте src/content/site/contacts.md');

const d = entry.data as Record<string, unknown>;
// Контактные значения берём из общих «Настроек сайта» (единый источник)
const s = await getSiteSettings();
---

<Layout title={String(d.title)} description={d.description ? String(d.description) : undefined}>
  <section class="border-b border-slate-100 py-20 bg-white">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <p class="text-[11px] font-semibold text-blue-700 uppercase tracking-[0.2em] mb-3">{d.heroEyebrow}</p>
      <h1 class="font-display text-4xl md:text-5xl font-semibold text-slate-900 tracking-tight">{d.heroTitle}</h1>
    </div>
  </section>

  <section class="py-16 bg-slate-50">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
        <!-- Phone -->
        <div class="border border-slate-200/90 rounded-3xl p-6 bg-white shadow-sm">
          <div class="w-11 h-11 bg-gradient-to-br from-blue-500/15 to-blue-600/5 rounded-2xl flex items-center justify-center mb-4 ring-1 ring-blue-500/10">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-slate-900 mb-1">{d.phoneTitle}</h3>
          <a href={s.companyPhoneHref} class="text-blue-600 hover:underline text-sm">{s.companyPhone}</a>
          <p class="text-xs text-slate-400 mt-1">{d.phoneHint}</p>
        </div>

        <!-- Email -->
        <div class="border border-slate-200/90 rounded-3xl p-6 bg-white shadow-sm">
          <div class="w-11 h-11 bg-gradient-to-br from-blue-500/15 to-blue-600/5 rounded-2xl flex items-center justify-center mb-4 ring-1 ring-blue-500/10">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-slate-900 mb-1">{d.emailTitle}</h3>
          <a href={`mailto:${s.companyEmail}`} class="text-blue-600 hover:underline text-sm">{s.companyEmail}</a>
          <p class="text-xs text-slate-400 mt-1">{d.emailHint}</p>
        </div>

        <!-- Messengers -->
        <div class="border border-slate-200/90 rounded-3xl p-6 bg-white shadow-sm">
          <div class="w-11 h-11 bg-gradient-to-br from-blue-500/15 to-blue-600/5 rounded-2xl flex items-center justify-center mb-4 ring-1 ring-blue-500/10">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-slate-900 mb-3">{d.messengersTitle}</h3>
          <div class="flex gap-3">
            <a
              href={s.telegram}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-3 py-2 rounded-xl bg-gradient-to-r from-blue-500 to-blue-600 text-white text-xs font-semibold hover:from-blue-400 hover:to-blue-500 transition-all shadow-sm"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
              </svg>
              {d.telegramLabel}
            </a>
            <a
              href={s.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-3 py-2 bg-green-500 text-white text-xs font-medium rounded-lg hover:bg-green-600 transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              {d.whatsappLabel}
            </a>
          </div>
        </div>
      </div>

      <!-- Address + Map placeholder -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
        <div class="border border-slate-200/90 rounded-3xl p-6 bg-white shadow-sm">
          <h3 class="font-display font-semibold text-slate-900 mb-4">{d.officeTitle}</h3>
          <div class="space-y-2 text-sm text-slate-600">
            <p>{s.companyName}</p>
            <p>{s.companyAddress}</p>
            <p>{s.companyHours}</p>
            <p class="mt-4 text-xs text-slate-400">{s.companyUnp}</p>
          </div>
        </div>
        <div class="rounded-xl bg-slate-100 overflow-hidden flex items-center justify-center" style="min-height: 200px;">
          <p class="text-sm text-slate-400">{d.mapPlaceholder}</p>
        </div>
      </div>

      <!-- Форма обратного звонка -->
      <div id="callback" class="max-w-xl mx-auto w-full scroll-mt-28">
        <ContactForm
          variant="callback"
          title={String(d.callbackFormTitle)}
          subtitle={String(d.callbackFormSubtitle)}
        />
      </div>
    </div>
  </section>
</Layout>
