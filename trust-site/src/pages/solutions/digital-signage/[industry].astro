---
import Layout from '../../../layouts/Layout.astro';
import ContactForm from '../../../components/ContactForm.astro';
import SolutionsNav from '../../../components/SolutionsNav.astro';
import { siteImg } from '../../../lib/site-images';
import { getEntry } from 'astro:content';

export async function getStaticPaths() {
  const entry = await getEntry('site', 'digital-signage');
  if (!entry) return [];
  const industries = (entry.data as any).industries as Array<{ slug?: string }>;
  return industries
    .filter((i) => Boolean(i.slug))
    .map((i) => ({ params: { industry: i.slug! } }));
}

const { industry } = Astro.params as { industry: string };

const entry = await getEntry('site', 'digital-signage');
if (!entry) throw new Error('Добавьте src/content/site/digital-signage.md');

const data = entry.data as Record<string, any>;
const industries = data.industries as Array<{ slug: string; title: string; desc: string; imageKey: string; tag: string }>;
const ind = industries.find((i) => i.slug === industry);
if (!ind) throw new Error(`Отрасль "${industry}" не найдена в digital-signage.md`);

const details = (data.industryDetails ?? {})[industry] ?? {};
const heroBadge: string = details.heroBadge ?? ind.tag;
const heroTitle: string = details.heroTitle ?? ind.title;
const heroLead: string = details.heroLead ?? ind.desc;
const intro: string | undefined = details.intro;
const benefits: Array<{ title: string; desc: string }> = details.benefits ?? [];
const cta: string | undefined = details.cta;
const projects: Array<{ title: string; desc: string; image?: string; imageKey?: string; href?: string }> = details.projects ?? [];
const projectsTitle: string = details.projectsTitle ?? 'Реализованные проекты';
const projectsSourceLabel: string | undefined = details.projectsSourceLabel;
const projectsSourceHref: string | undefined = details.projectsSourceHref;
const heroImg = siteImg(ind.imageKey);

const pageTitle = `${heroTitle} — SmartPlayer`;
const pageDesc = heroLead;
---

<Layout title={pageTitle} description={pageDesc}>

  <SolutionsNav />

  <!-- Breadcrumb -->
  <nav class="max-w-6xl mx-auto px-6 lg:px-8 pt-6" aria-label="Хлебные крошки">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-slate-500">
      <a href="/solutions" class="hover:text-blue-600 transition-colors">Решения</a>
      <span class="text-slate-300">/</span>
      <a href="/solutions/digital-signage" class="hover:text-blue-600 transition-colors">Digital Signage</a>
      <span class="text-slate-300">/</span>
      <span class="text-slate-700">{ind.title}</span>
    </div>
  </nav>

  <!-- Back banner -->
  <div class="max-w-6xl mx-auto px-6 lg:px-8 pt-4">
    <a
      href="/solutions/digital-signage#industries"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-slate-200 text-slate-700 text-sm font-medium hover:border-blue-300 hover:text-blue-600 transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      Назад ко всем отраслям
    </a>
  </div>

  <!-- Hero -->
  <section class="border-b border-slate-100 py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="inline-block text-xs font-semibold text-blue-600 uppercase tracking-widest mb-5 px-3 py-1 bg-blue-50 rounded-full">
            {heroBadge}
          </span>
          <h1 class="text-4xl md:text-5xl font-semibold text-slate-900 leading-tight mb-5">
            {heroTitle}
          </h1>
          <p class="text-lg text-slate-500 leading-relaxed mb-6">
            {heroLead}
          </p>
          {intro && (
            <p class="text-base text-slate-500 mb-8">{intro}</p>
          )}
          <div class="flex flex-wrap gap-3">
            <a href="#demo" class="px-6 py-3.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
              Запросить демо-доступ
            </a>
            <a href="/solutions/digital-signage" class="px-6 py-3.5 border border-slate-200 text-slate-700 text-sm font-medium rounded-lg hover:border-slate-400 transition-colors">
              О платформе SmartPlayer
            </a>
          </div>
        </div>
        <div class="relative">
          <div class="rounded-2xl overflow-hidden aspect-[4/3] bg-slate-900">
            <img
              src={heroImg}
              alt={heroTitle}
              width={900}
              height={675}
              class="w-full h-full object-cover"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  {benefits.length > 0 && (
    <section class="py-20">
      <div class="max-w-6xl mx-auto px-6 lg:px-8">
        <div class="mb-12">
          <p class="text-xs font-semibold text-blue-600 uppercase tracking-widest mb-2">Возможности</p>
          <h2 class="text-3xl md:text-4xl font-semibold text-slate-900">Что получает {ind.title.toLowerCase()}</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {benefits.map((b) => (
            <div class="fade-in border border-slate-200 rounded-xl p-6 hover:border-blue-200 hover:shadow-sm transition-all">
              <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <h3 class="font-semibold text-slate-900 mb-2">{b.title}</h3>
              <p class="text-sm text-slate-500 leading-relaxed">{b.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {projects.length > 0 && (
    <section class="py-20">
      <div class="max-w-6xl mx-auto px-6 lg:px-8">
        <div class="flex items-end justify-between mb-10 flex-wrap gap-3">
          <div>
            <p class="text-xs font-semibold text-blue-600 uppercase tracking-widest mb-2">Кейсы</p>
            <h2 class="text-3xl md:text-4xl font-semibold text-slate-900">{projectsTitle}</h2>
          </div>
          {projectsSourceHref && projectsSourceLabel && (
            <a href={projectsSourceHref} target="_blank" rel="noopener noreferrer" class="text-sm text-blue-600 hover:text-blue-700 inline-flex items-center gap-1">
              {projectsSourceLabel}
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
          )}
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {projects.map((p) => (
            <article class="fade-in rounded-2xl overflow-hidden border border-slate-200 bg-white">
              <div class="aspect-[16/10] bg-slate-100">
                <img
                  src={p.image ?? (p.imageKey ? siteImg(p.imageKey) : '')}
                  alt={p.title}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
              <div class="p-5">
                <h3 class="font-semibold text-slate-900 mb-2">{p.title}</h3>
                <p class="text-sm text-slate-500 leading-relaxed">{p.desc}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Other industries -->
  <section class="py-16 bg-slate-50 border-y border-slate-100">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="flex items-end justify-between mb-8 flex-wrap gap-3">
        <h2 class="text-2xl font-semibold text-slate-900">Другие отрасли</h2>
        <a href="/solutions/digital-signage#industries" class="text-sm text-blue-600 hover:text-blue-700 font-medium">
          Все отрасли →
        </a>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3">
        {industries.filter((i) => i.slug !== industry).slice(0, 10).map((i) => (
          <a
            href={`/solutions/digital-signage/${i.slug}`}
            class="block px-4 py-3 rounded-lg bg-white border border-slate-200 text-sm text-slate-700 hover:border-blue-300 hover:text-blue-600 transition-colors"
          >
            {i.title}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Demo form -->
  <div id="demo" class="max-w-6xl mx-auto px-6 lg:px-8 py-20">
    {cta && <p class="text-center text-slate-500 mb-8 max-w-2xl mx-auto">{cta}</p>}
    <ContactForm
      variant="demo"
      title={`Запросить демо-доступ SmartPlayer — ${ind.title}`}
      subtitle="Предоставим бесплатный тестовый доступ к платформе на 14 дней."
    />
  </div>

</Layout>
