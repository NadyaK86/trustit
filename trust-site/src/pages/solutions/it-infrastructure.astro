---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
import SolutionsNav from '../../components/SolutionsNav.astro';
import { siteImg } from '../../lib/site-images';
import { getEntry } from 'astro:content';

const entry = await getEntry('site', 'it-infrastructure');
if (!entry) throw new Error('Добавьте src/content/site/it-infrastructure.md');

const d = entry.data as Record<string, any>;
const items = d.items as Array<{ title: string; desc: string; bullets?: string[]; sourceLabel?: string; sourceHref?: string }>;
const vendors = (d.vendors as Array<any> | undefined) ?? [];
const heroImg = d.heroImageKey ? siteImg(String(d.heroImageKey)) : null;
---

<Layout title={String(d.title)} description={d.description ? String(d.description) : undefined}>
  <SolutionsNav />
  <section class="border-b border-slate-100 py-16">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div>
          <span class="inline-block text-xs font-semibold text-blue-600 uppercase tracking-widest mb-4 px-3 py-1 bg-blue-50 rounded-full">{d.heroBadge}</span>
          <h1 class="text-4xl md:text-5xl font-semibold text-slate-900 leading-tight mb-4">{d.pageTitle}</h1>
          <p class="text-lg text-slate-500 leading-relaxed">{d.lead}</p>
        </div>
        {heroImg && (
          <div class="rounded-2xl overflow-hidden aspect-[4/3] bg-slate-100">
            <img src={heroImg} alt={String(d.pageTitle)} class="w-full h-full object-cover" loading="eager" />
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {items.map((s, i) => (
          <article class="fade-in border border-slate-200 rounded-2xl p-6 bg-white hover:shadow-md transition-shadow">
            <span class="text-2xl font-light text-slate-200 font-mono">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 font-semibold text-slate-900">{s.title}</h3>
            <p class="mt-2 text-sm text-slate-500 leading-relaxed">{s.desc}</p>
            {s.bullets && (
              <ul class="mt-3 space-y-1">
                {s.bullets.map((b) => (
                  <li class="flex items-start gap-2 text-xs text-slate-600">
                    <span class="w-1.5 h-1.5 bg-blue-500 rounded-full mt-1.5 shrink-0"></span>
                    {b}
                  </li>
                ))}
              </ul>
            )}
            {s.sourceHref && (
              <a href={s.sourceHref} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-1 text-xs text-blue-600 hover:text-blue-700">
                Подробнее: {s.sourceLabel}
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  {vendors.length > 0 && (
    <section class="py-20 bg-slate-50 border-y border-slate-100">
      <div class="max-w-6xl mx-auto px-6 lg:px-8">
        <h2 class="text-2xl font-semibold text-slate-900 mb-2">{d.vendorsTitle}</h2>
        {d.vendorsLead && <p class="text-slate-500 mb-8 max-w-2xl">{d.vendorsLead}</p>}
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {vendors.map((v) => (
            <a href={v.href} target="_blank" rel="noopener noreferrer" class="block p-5 bg-white rounded-xl border border-slate-200 hover:border-blue-300 hover:shadow-sm transition-all">
              <div class="font-semibold text-slate-900">{v.name}</div>
              <div class="text-xs text-slate-500 mt-1">{v.desc}</div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <div class="max-w-6xl mx-auto px-6 lg:px-8 py-24">
    <ContactForm variant="estimate" title={String(d.formTitle)} subtitle={String(d.formSubtitle)} />
  </div>
</Layout>
