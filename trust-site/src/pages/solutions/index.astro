---
import Layout from '../../layouts/Layout.astro';
import SolutionsNav from '../../components/SolutionsNav.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('site', 'solutions');
if (!entry) throw new Error('Добавьте src/content/site/solutions.md');

const d = entry.data as Record<string, unknown>;
const solutions = d.solutions as Array<{
  title: string;
  tag: string;
  desc: string;
  href: string;
  features: string[];
}>;
---

<Layout title={String(d.title)} description={d.description ? String(d.description) : undefined}>
  <SolutionsNav />
  <div class="max-w-6xl mx-auto px-6 lg:px-8 py-16">
    <div class="mb-16">
      <p class="text-xs font-semibold text-blue-600 uppercase tracking-widest mb-3">{d.eyebrow}</p>
      <h1 class="text-4xl md:text-5xl font-semibold text-slate-900">{d.pageTitle}</h1>
      <p class="mt-4 text-lg text-slate-500 max-w-2xl">
        {d.lead}
      </p>
    </div>

    <div class="space-y-6">
      {solutions.map((p, i) => (
        <a
          href={p.href}
          class="fade-in group block border border-slate-200 rounded-xl p-8 hover:border-blue-300 hover:shadow-sm transition-all"
        >
          <div class="flex flex-col md:flex-row md:items-start gap-6">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-3">
                <span class="text-xs font-mono text-slate-300">0{i + 1}</span>
                <span class="text-xs text-blue-600 bg-blue-50 px-2 py-0.5 rounded-full">{p.tag}</span>
              </div>
              <h2 class="text-2xl font-semibold text-slate-900 group-hover:text-blue-600 transition-colors mb-2">{p.title}</h2>
              <p class="text-slate-500 text-sm leading-relaxed">{p.desc}</p>
            </div>
            <div class="md:w-72 shrink-0">
              <ul class="space-y-2">
                {p.features.map(f => (
                  <li class="flex items-center gap-2 text-sm text-slate-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>
              <span class="mt-4 inline-flex items-center gap-1 text-sm text-blue-600 font-medium">
                Подробнее
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
