---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
import SolutionsNav from '../../components/SolutionsNav.astro';
import { siteImg } from '../../lib/site-images';
import { getEntry } from 'astro:content';

const entry = await getEntry('site', 'meeting-rooms');
if (!entry) throw new Error('Добавьте src/content/site/meeting-rooms.md');

const d = entry.data as Record<string, any>;
const roomTypes = (d.roomTypes as Array<any> | undefined)?.map((r) => ({
  ...r,
  img: r.imageKey ? siteImg(r.imageKey) : null,
})) ?? [];
const solutions = (d.solutions as Array<any> | undefined) ?? [];
const heroImg = d.heroImageKey ? siteImg(String(d.heroImageKey)) : null;

function isExternal(href: string) {
  return /^https?:\/\//i.test(href);
}
---

<Layout title={String(d.title)} description={d.description ? String(d.description) : undefined}>
  <SolutionsNav />
  <section class="border-b border-slate-100 py-16">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div>
          <span class="inline-block text-xs font-semibold text-slate-900 uppercase tracking-widest mb-4 px-3 py-1 bg-slate-100 rounded-full">{d.heroBadge}</span>
          <h1 class="text-4xl md:text-5xl font-semibold text-slate-900 leading-tight mb-4">{d.pageTitle}</h1>
          <p class="text-lg text-slate-500 leading-relaxed">{d.lead}</p>
        </div>
        {heroImg && (
          <div class="rounded-2xl overflow-hidden aspect-[4/3] bg-slate-100">
            <img src={heroImg} alt={String(d.pageTitle)} class="w-full h-full object-cover" />
          </div>
        )}
      </div>
    </div>
  </section>

  {roomTypes.length > 0 && (
    <section class="py-20 bg-slate-50">
      <div class="max-w-6xl mx-auto px-6 lg:px-8">
        <div class="mb-10">
          <p class="text-xs font-semibold text-blue-600 uppercase tracking-widest mb-2">{d.roomTypesEyebrow}</p>
          <h2 class="text-3xl md:text-4xl font-semibold text-slate-900">{d.roomTypesTitle}</h2>
          {d.roomTypesLead && <p class="text-slate-500 mt-3 max-w-2xl">{d.roomTypesLead}</p>}
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {roomTypes.map((r) => (
            <article class="fade-in bg-white border border-slate-200 rounded-2xl overflow-hidden flex flex-col">
              {r.img && (
                <div class="aspect-[16/10] overflow-hidden bg-slate-100">
                  <img src={r.img} alt={r.title} class="w-full h-full object-cover" loading="lazy" />
                </div>
              )}
              <div class="p-6 flex-1 flex flex-col">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-xs font-mono uppercase tracking-wider text-blue-600">{r.size}</span>
                  <span class="text-xs text-slate-500">{r.capacity}</span>
                </div>
                <h3 class="text-xl font-semibold text-slate-900 mb-2">{r.title}</h3>
                <p class="text-sm text-slate-500 leading-relaxed mb-4">{r.desc}</p>
                {r.bullets && (
                  <ul class="space-y-1 mb-2">
                    {(r.bullets as string[]).map((b) => (
                      <li class="flex items-start gap-2 text-xs text-slate-600">
                        <span class="w-1.5 h-1.5 bg-blue-500 rounded-full mt-1.5 shrink-0"></span>
                        {b}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="py-20">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="mb-10">
        <p class="text-xs font-semibold text-blue-600 uppercase tracking-widest mb-2">{d.solutionsEyebrow}</p>
        <h2 class="text-3xl md:text-4xl font-semibold text-slate-900">{d.solutionsTitle}</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {solutions.map((s) => (
          <a
            href={s.href}
            target={isExternal(s.href) ? '_blank' : undefined}
            rel={isExternal(s.href) ? 'noopener noreferrer' : undefined}
            class="fade-in group flex flex-col bg-white border border-slate-200 rounded-2xl p-6 hover:border-blue-300 hover:shadow-md transition-all"
          >
            <h3 class="font-semibold text-slate-900 group-hover:text-blue-700 transition-colors mb-2">{s.title}</h3>
            <p class="text-sm text-slate-500 leading-relaxed mb-3 flex-1">{s.desc}</p>
            {s.bullets && (
              <ul class="space-y-1 mb-3">
                {(s.bullets as string[]).map((b) => (
                  <li class="flex items-center gap-2 text-xs text-slate-600">
                    <span class="w-1 h-1 bg-blue-500 rounded-full shrink-0"></span>
                    {b}
                  </li>
                ))}
              </ul>
            )}
            <span class="inline-flex items-center gap-1 text-sm text-blue-600 font-medium mt-auto">
              {s.cta || 'Подробнее'}
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-6 lg:px-8 pb-24">
    <ContactForm variant="estimate" title={String(d.formTitle)} subtitle={String(d.formSubtitle)} />
  </div>
</Layout>
