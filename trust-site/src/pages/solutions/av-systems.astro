---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
import SolutionsNav from '../../components/SolutionsNav.astro';
import { siteImg } from '../../lib/site-images';
import { getEntry } from 'astro:content';

const entry = await getEntry('site', 'av-systems');
if (!entry) throw new Error('Добавьте src/content/site/av-systems.md');

const d = entry.data as Record<string, any>;
const categories = (d.categories as Array<any>).map((c) => ({
  ...c,
  img: c.imageKey ? siteImg(c.imageKey) : null,
}));
const heroImg = d.heroImageKey ? siteImg(String(d.heroImageKey)) : null;
---

<Layout title={String(d.title)} description={d.description ? String(d.description) : undefined}>
  <SolutionsNav />
  <section class="border-b border-slate-100 py-16">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div>
          <span class="inline-block text-xs font-semibold text-blue-600 uppercase tracking-widest mb-4 px-3 py-1 bg-blue-50 rounded-full">{d.heroBadge}</span>
          <h1 class="text-4xl md:text-5xl font-semibold text-slate-900 leading-tight mb-4">{d.pageTitle}</h1>
          <p class="text-lg text-slate-500 leading-relaxed">{d.lead}</p>
        </div>
        {heroImg && (
          <div class="rounded-2xl overflow-hidden aspect-[4/3] bg-slate-100">
            <img src={heroImg} alt={String(d.pageTitle)} class="w-full h-full object-cover" />
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {categories.map((c, i) => (
          <article class="fade-in border border-slate-200 rounded-2xl overflow-hidden bg-white hover:shadow-md transition-shadow flex flex-col">
            <div class="aspect-video bg-slate-100 relative overflow-hidden">
              {c.img ? (
                <img src={c.img} alt={c.title} class="w-full h-full object-cover" loading="lazy" />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-sm text-slate-400">Фото: {c.title}</div>
              )}
              <span class="absolute top-3 left-3 bg-white/90 backdrop-blur px-2.5 py-1 rounded-full text-[11px] font-mono text-slate-600">
                {String(i + 1).padStart(2, '0')}
              </span>
            </div>
            <div class="p-6 flex-1 flex flex-col">
              <h2 class="text-xl font-semibold text-slate-900 mb-2">{c.title}</h2>
              <p class="text-sm text-slate-500 leading-relaxed mb-4">{c.desc}</p>
              {c.specs && (
                <ul class="space-y-1 mb-4">
                  {(c.specs as string[]).map((s) => (
                    <li class="flex items-center gap-2 text-xs text-slate-600">
                      <span class="w-1.5 h-1.5 bg-blue-500 rounded-full shrink-0"></span>
                      {s}
                    </li>
                  ))}
                </ul>
              )}
              {c.sourceHref && (
                <a href={c.sourceHref} target="_blank" rel="noopener noreferrer" class="mt-auto inline-flex items-center gap-1 text-xs text-blue-600 hover:text-blue-700">
                  Подробнее у вендора: {c.sourceLabel}
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-6 lg:px-8 pb-24">
    <ContactForm variant="estimate" title={String(d.formTitle)} subtitle={String(d.formSubtitle)} />
  </div>
</Layout>
