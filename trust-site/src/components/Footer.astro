---
import { getSiteSettings } from '../lib/site-settings';
const s = await getSiteSettings();
const year = new Date().getFullYear();
---

<!-- П. 4.2 ТЗ: тёмный подвал — графитово-синий #0F1929 -->
<footer class="mt-24 border-t border-white/10 bg-[#0F1929] text-slate-400">
  <div class="max-w-6xl mx-auto px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12 md:gap-10">
      <div class="md:col-span-1">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center shadow-md shadow-black/30 ring-2 ring-white/10">
            <span class="text-white font-bold text-sm font-display">Т</span>
          </div>
          <span class="font-display font-semibold text-white text-sm tracking-tight">ТрастИнкомТрэйд</span>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed">
          Системная интеграция и аудиовизуальные решения для бизнеса в Республике Беларусь.
        </p>
        <p class="text-sm mt-4 text-slate-500">
          Официальный представитель <span class="text-sky-400 font-medium">SmartPlayer</span> в РБ.
        </p>
      </div>

      <div>
        <h4 class="font-display text-white text-sm font-semibold mb-4">Каталог и решения</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/catalog" class="hover:text-sky-400 transition-colors">Каталог товаров</a></li>
          <li><a href="/solutions/digital-signage" class="hover:text-sky-400 transition-colors">Digital Signage (SmartPlayer)</a></li>
          <li><a href="/solutions/av-systems" class="hover:text-sky-400 transition-colors">Аудиовизуальные системы</a></li>
          <li><a href="/solutions/meeting-rooms" class="hover:text-sky-400 transition-colors">Переговорные комнаты</a></li>
          <li><a href="/solutions/it-infrastructure" class="hover:text-sky-400 transition-colors">IT-инфраструктура</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-display text-white text-sm font-semibold mb-4">Услуги</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/services#content" class="hover:text-sky-400 transition-colors">Разработка контента</a></li>
          <li><a href="/services#commissioning" class="hover:text-sky-400 transition-colors">Пусконаладочные работы</a></li>
          <li><a href="/services#installation" class="hover:text-sky-400 transition-colors">Монтаж</a></li>
          <li><a href="/services#support" class="hover:text-sky-400 transition-colors">Техническое обслуживание</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-display text-white text-sm font-semibold mb-4">Контакты</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href={s.companyPhoneHref} class="hover:text-sky-400 transition-colors">{s.companyPhone}</a></li>
          <li><a href={`mailto:${s.companyEmail}`} class="hover:text-sky-400 transition-colors">{s.companyEmail}</a></li>
          <li class="text-slate-500">{s.companyAddress}</li>
        </ul>
        <div class="flex gap-2 mt-5">
          <a href={s.telegram} target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg border border-white/10 text-slate-400 hover:text-sky-400 hover:border-sky-500/40 transition-colors" title="Telegram">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
            </svg>
          </a>
          <a href={s.whatsapp} target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg border border-white/10 text-slate-400 hover:text-emerald-400 hover:border-emerald-500/40 transition-colors" title="WhatsApp">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="mt-14 pt-8 border-t border-white/10 flex flex-col sm:flex-row justify-between items-center gap-3 text-xs text-slate-500">
      <p>© {year} ООО «ТрастИнкомТрэйд». Все права защищены.</p>
      <div class="flex items-center gap-4">
        <a href="/privacy" class="hover:text-sky-400 transition-colors">Политика обработки ПДн</a>
        <span>Республика Беларусь</span>
      </div>
    </div>
  </div>
</footer>
