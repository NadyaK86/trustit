---
/**
 * Плавающая кнопка «Перезвоните мне» → форма обратного звонка на странице Контакты (#callback).
 */
---

<div class="fixed bottom-5 right-5 z-[60] flex flex-col items-end gap-2 pointer-events-none">
  <a
    href="/contacts#callback"
    class="pointer-events-auto cursor-pointer inline-flex items-center gap-2 pl-4 pr-5 py-3 rounded-full bg-gradient-to-r from-blue-600 to-blue-700 text-white text-sm font-semibold shadow-lg shadow-blue-900/25 hover:from-blue-500 hover:to-blue-600 transition-all ring-2 ring-white/90"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
    </svg>
    Перезвоните мне
  </a>
</div>
